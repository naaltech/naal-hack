---
import "leaflet/dist/leaflet.css"
---

<div class="h-64 w-full rounded-lg overflow-hidden border bg-muted">
  <div data-event-map class="h-full w-full flex items-center justify-center">
    <p class="text-muted-foreground">Harita yükleniyor...</p>
  </div>
</div>

<script>
  import L from "leaflet"

  const container = document.querySelector<HTMLElement>("[data-event-map]")

  if (container) {
    // Atölye Üsküdar coordinates (approximate)
    const position: L.LatLngTuple = [41.0206386, 29.0198576]

    delete (L.Icon.Default.prototype as any)._getIconUrl
    L.Icon.Default.mergeOptions({
      iconRetinaUrl: "https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.7.1/images/marker-icon-2x.png",
      iconUrl: "https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.7.1/images/marker-icon.png",
      shadowUrl: "https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.7.1/images/marker-shadow.png",
    })

    container.replaceChildren()
    container.classList.remove("flex", "items-center", "justify-center")

    const map = L.map(container).setView(position, 15)

    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
    }).addTo(map)

    L.marker(position)
      .addTo(map)
      .bindPopup(
        `<div class="text-center">
          <strong>Atölye Üsküdar</strong>
          <br />
          Etkinlik Merkezi
          <br />
          <small>Naal'Hack</small>
        </div>`
      )
  }
</script>
