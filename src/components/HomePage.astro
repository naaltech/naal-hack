---
import AtSymbolIcon from "heroicons/24/outline/at-symbol.svg"
import BoltIcon from "heroicons/24/outline/bolt.svg"
import BriefcaseIcon from "heroicons/24/outline/briefcase.svg"
import CalendarIcon from "heroicons/24/outline/calendar.svg"
import CameraIcon from "heroicons/24/outline/camera.svg"
// import ChatBubbleLeftRightIcon from "heroicons/24/outline/chat-bubble-left-right.svg"
import ChevronDownIcon from "heroicons/24/outline/chevron-down.svg"
import ClockIcon from "heroicons/24/outline/clock.svg"
import CodeBracketIcon from "heroicons/24/outline/code-bracket.svg"
import LightBulbIcon from "heroicons/24/outline/light-bulb.svg"
import MapPinIcon from "heroicons/24/outline/map-pin.svg"
import UsersIcon from "heroicons/24/outline/users.svg"
import Badge from "@/components/ui/Badge.astro"
import Button from "@/components/ui/Button.astro"
import EventEndedModal from "@/components/EventEndedModal.astro"
import EventMap from "@/components/EventMap.astro"
import LanguageSwitcher from "@/components/LanguageSwitcher.astro"
import Layout from "@/layouts/Layout.astro"
import { translations, type Language } from "@/lib/i18n"

interface Props {
  lang: Language
}

const { lang } = Astro.props
const t = translations[lang]

const navLinks = [
  { href: "#about", label: t.nav.about },
  { href: "#program", label: t.nav.program },
  { href: "#kayit", label: t.nav.register },
  { href: "#sponsorlar", label: t.nav.sponsors },
  { href: "#sss", label: t.nav.faq },
]

const features = [
  { icon: UsersIcon, label: t.eventArea.features.participants },
  { icon: BoltIcon, label: t.eventArea.features.internet },
  { icon: CodeBracketIcon, label: t.eventArea.features.equipment },
  { icon: LightBulbIcon, label: t.eventArea.features.creative },
]

const days = [t.program.schedule.day1, t.program.schedule.day2]

const sponsors = [
  { src: "https://static.mlh.io/brand-assets/sponsors/github/github-logo.svg", alt: "GitHub" },
  { src: "https://static.mlh.io/brand-assets/sponsors/stand-out-stickers/stand-out-stickers-logo.png", alt: "Stand Out Stickers" },
]

const partners = [
  { src: "https://static.mlh.io/brand-assets/logo/official/mlh-logo-color.png", alt: "MLH" },
  { src: "https://hcb.hackclub.com/brand/hcb-icon-icon-original.png", alt: "Hack Club Bank" },
  { src: "/atolyeuskudar.png", alt: "Atölye Üsküdar" },
]

const logoRows = [
  { logos: sponsors },
  { title: t.sponsors.partnerships, logos: partners },
]

const socialLinks = [
  { href: "https://instagram.com/naalhack", icon: CameraIcon, label: t.social.instagram },
  // { href: "https://discord.gg/7pS5NsAPWV/", icon: ChatBubbleLeftRightIcon, label: t.social.discord },
  { href: "https://x.com/naalteknoloji/", icon: AtSymbolIcon, label: t.social.twitter },
  { href: "https://www.linkedin.com/company/naaltech/", icon: BriefcaseIcon, label: t.social.linkedin },
]
---

<Layout lang={lang}>
  <div class="min-h-screen bg-background">
    <EventEndedModal lang={lang} />
    {/* Header */}
    <header class="border-b bg-card/50 backdrop-blur-sm sticky top-0 z-50">
      <div class="container mx-auto px-4 py-4">
        <nav class="flex items-center justify-between">
          <div class="text-2xl font-bold text-primary">naalhack</div>
          <div class="hidden md:flex items-center space-x-6">
            {navLinks.map((link) => (
              <a href={link.href} class="text-muted-foreground hover:text-primary transition-colors">
                {link.label}
              </a>
            ))}
            <LanguageSwitcher lang={lang} />
          </div>
          <div class="md:hidden flex items-center space-x-2">
            <LanguageSwitcher lang={lang} />
          </div>
        </nav>
      </div>
    </header>

    {/* Hero Section */}
    <section class="py-20 bg-gradient-to-br from-primary/5 via-background to-accent/5">
      <div class="container mx-auto px-4 text-center">
        <div class="max-w-4xl mx-auto">
          <div class="mb-6 flex justify-center">
            <img
              src="/logo_text.png"
              alt="naalhack logo"
              class="h-24 md:h-32 lg:h-40 w-auto object-contain"
            />
          </div>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-2 text-base sm:text-lg text-foreground mb-8">
            <div class="flex items-center gap-2">
              <CalendarIcon class="h-5 w-5 text-primary" />
              <span>{t.hero.date}</span>
            </div>
            <div class="flex items-center gap-2">
              <MapPinIcon class="h-5 w-5 text-primary" />
              <span>{t.hero.location}</span>
            </div>
          </div>
          <div class="flex flex-wrap gap-4 justify-center">
            <Button data-tally-open="mZaeAV" size="lg" class="bg-primary hover:bg-primary/90">
              {t.hero.register}
            </Button>
            <Button
              href="mailto:hack@naal.org.tr"
              size="lg"
              variant="outline"
              class="border-accent text-accent hover:bg-accent hover:text-accent-foreground bg-transparent"
            >
              {t.hero.sponsor}
            </Button>
            {/* <Button href="https://discord.gg/7pS5NsAPWV" target="_blank" rel="noopener noreferrer" size="lg" variant="outline">
              {t.hero.discord}
            </Button> */}
            <Button href="https://naal-hack.devpost.com" target="_blank" rel="noopener noreferrer" size="lg" variant="outline">
              {t.hero.devpost}
            </Button>
          </div>
        </div>
      </div>
    </section>

    {/* About Section */}
    <section id="about" class="py-16">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center">
          <h2 class="text-3xl md:text-4xl font-bold text-primary mb-8">{t.about.title}</h2>
          <p class="text-lg text-muted-foreground leading-relaxed">
            {t.about.description}
          </p>
        </div>
      </div>
    </section>

    {/* Event Area Info */}
    <section class="py-16 bg-muted/30">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-bold text-primary text-center mb-12">{t.eventArea.title}</h2>
          <div class="grid md:grid-cols-2 gap-8 items-center">
            <div>
              <p class="text-lg text-muted-foreground mb-6">
                {t.eventArea.description}
              </p>
              <div class="grid grid-cols-2 gap-4">
                {features.map(({ icon: Icon, label }) => (
                  <div class="flex items-center gap-2">
                    <Icon class="h-5 w-5 text-primary" />
                    <span>{label}</span>
                  </div>
                ))}
              </div>
            </div>
            <div>
              <EventMap />
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Program */}
    <section id="program" class="py-16">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-bold text-primary text-center mb-12">{t.program.title}</h2>
          {/* <h3 class="text-2xl md:text-2xl font-light text-primary text-center mb-12">{t.program.tbd}</h3> */}

          <div class="space-y-6">
            {days.map((day) => (
              <div class="bg-card rounded-lg border p-6">
                <h3 class="text-xl font-semibold text-primary mb-4 flex items-center gap-2">
                  <ClockIcon class="h-5 w-5 text-primary" />
                  {day.title}
                </h3>
                <div class="space-y-3">
                  {day.events.map((event) => (
                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center py-3 border-b border-border/50 last:border-b-0 gap-2">
                      <span class="text-muted-foreground text-sm sm:text-base">{event.time} - {event.activity}</span>
                      <Badge class="whitespace-nowrap">{event.type}</Badge>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* Registration */}
    <section id="kayit" class="py-16 bg-primary/5">
      <div class="container mx-auto px-4 text-center">
        <div class="max-w-2xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-bold text-primary mb-6">{t.registration.title}</h2>
          <p class="text-lg text-muted-foreground mb-8">
            {t.registration.description}
          </p>
          <Button data-tally-open="mZaeAV" size="lg" class="bg-primary hover:bg-primary/90 text-lg px-8 py-3">
            {t.registration.button}
          </Button>
        </div>
      </div>
    </section>

    {/* Sponsors */}
    <section id="sponsorlar" class="py-16">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto text-center">
          <h2 class="text-3xl md:text-4xl font-bold text-primary mb-12">{t.sponsors.title}</h2>
          {logoRows.map(({ title, logos }) => (
            <>
              {title && <h3 class="text-3xl md:text-4xl font-bold text-primary mb-12">{title}</h3>}
              <div class="flex flex-wrap justify-center items-center gap-8 mb-8">
                {logos.map((logo) => (
                  <div class="w-32 h-20 bg-white rounded-lg flex items-center justify-center p-2 border">
                    <img src={logo.src} alt={logo.alt} class="max-w-full max-h-full object-contain" />
                  </div>
                ))}
              </div>
            </>
          ))}

          <div class="mt-12">
            <p class="text-lg text-muted-foreground mb-6">
              {t.sponsors.sponsorText}
            </p>
            <Button
              href="mailto:hack@naal.org.tr"
              variant="outline"
              size="lg"
              class="border-accent text-accent hover:bg-accent hover:text-accent-foreground bg-transparent"
            >
              {t.sponsors.sponsorButton}
            </Button>
          </div>
        </div>
      </div>
    </section>

    {/* FAQ */}
    <section id="sss" class="py-16 bg-muted/30">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-bold text-primary text-center mb-12">{t.faq.title}</h2>
          <div class="space-y-4">
            {t.faq.questions.map((faq) => (
              <details
                name="faq"
                class="group bg-card rounded-lg px-6 [interpolate-size:allow-keywords] details-content:h-0 details-content:overflow-hidden details-content:transition-[height,content-visibility] details-content:duration-200 details-content:[transition-behavior:allow-discrete] open:details-content:h-auto"
              >
                <summary class="focus-visible:ring-ring/50 flex cursor-pointer list-none items-start justify-between gap-4 rounded-md py-4 text-left text-sm font-medium transition-all outline-none hover:underline focus-visible:ring-[3px] [&::-webkit-details-marker]:hidden">
                  {faq.question}
                  <ChevronDownIcon class="text-muted-foreground pointer-events-none size-4 shrink-0 translate-y-0.5 transition-transform duration-200 group-open:rotate-180" />
                </summary>
                <div class="pt-0 pb-4 text-sm text-muted-foreground">
                  {faq.answer}
                </div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* Social Media */}
    <section class="py-16">
      <div class="container mx-auto px-4 text-center">
        <div class="max-w-2xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-bold text-primary mb-8">{t.social.title}</h2>
          <p class="text-lg text-muted-foreground mb-8">
            {t.social.description}
          </p>
          <div class="flex flex-wrap gap-4 justify-center">
            {socialLinks.map(({ href, icon: Icon, label }) => (
              <Button href={href} target="_blank" rel="noopener noreferrer" variant="outline" size="lg" class="bg-transparent">
                <Icon class="w-5 h-5" />
                {label}
              </Button>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* Footer */}
    <footer class="bg-card border-t py-8">
      <div class="container mx-auto px-4">
        <div class="text-center text-muted-foreground">
          <p>&copy; {new Date().getFullYear()} {t.footer.copyright}</p>
          <p>{t.footer.opensource} <a href="https://github.com/naaltech/naal-hack">GitHub</a></p>
        </div>
      </div>
    </footer>
  </div>
</Layout>
